# Application query: hazards in the technical room (equipment room) via components and hazard sources
PREFIX ho61508: <https://w3id.org/jochumsson/ho61508#>
PREFIX h2hoa: <https://w3id.org/jochumsson/h2hoa#>
PREFIX nyhkb: <https://w3id.org/jochumsson/nyhkb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?component ?hazardSource ?hazard ?hazardComment
WHERE {
  ?component h2hoa:locatedIn nyhkb:Location_TechnicalRoom .
  ?component h2hoa:carries ?hazardSource .
  ?hazard ho61508:inheresIn ?hazardSource .

  ?hazard a ?hazardType .
  ?hazardType rdfs:subClassOf* ho61508:Hazard .

  OPTIONAL { ?hazard rdfs:comment ?hazardComment . }
}
ORDER BY ?component ?hazardSource ?hazard
