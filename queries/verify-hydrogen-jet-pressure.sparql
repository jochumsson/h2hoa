# Verify: every HydrogenJet situation involves JetFireHazard and PressureHazard
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ho61508: <https://w3id.org/jochumsson/ho61508#>
PREFIX h2ho: <https://w3id.org/jochumsson/h2ho#>
PREFIX h2hoa: <https://w3id.org/jochumsson/h2hoa#>

SELECT ?jetSituation ?hazard ?hazardType
WHERE {
  ?jetSituation rdf:type/rdfs:subClassOf* h2hoa:HydrogenJet .
  ?jetSituation ho61508:involves ?hazard .
  ?hazard rdf:type ?hazardType .
  ?hazardType rdfs:subClassOf* ho61508:Hazard .
}
ORDER BY ?jetSituation ?hazardType ?hazard
