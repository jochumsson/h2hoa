  ho61508:triggers
    nyhkb:Hazard_JetFire_TechnicalRoom ,
    nyhkb:Hazard_Deflagration_TechnicalRoom ,
    nyhkb:Hazard_Fireball_TechnicalRoom .

nyhkb:Event_StaticSparkIgnition_PipelineRoute a h2hoa:StaticSparkIgnition ;
