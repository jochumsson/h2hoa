#################################################################

nyhkb:HarmfulEvent_JetFire_TechnicalRoom a h2hoa:JetFire ;
  rdfs:label "Jet fire – technical room"@en ;
  dcterms:source "Appendix E, section 5.1.2.1 consequences"@en ;
  ho61508:causes nyhkb:Harm_BurnInjury_TechnicalRoom , nyhkb:Harm_PropertyDamage_TechnicalRoom ;
  ho61508:leadsTo nyhkb:Situation_EquipmentDamage_TechnicalRoom .

