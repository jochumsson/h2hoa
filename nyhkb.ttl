  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:resultsIn
    nyhkb:Situation_HydrogenJet_CompressorRoom ,
    nyhkb:Situation_ExplosiveAtmosphere_CompressorRoom ,
    nyhkb:Situation_FlammableCloud_CompressorRoom .

nyhkb:Event_Rupture_BufferCylinder a h2hoa:Rupture ;
  rdfs:label "Rupture - buffer cylinder"@en ;
  dcterms:source "Appendix E, section 5.3.2.2"@en ;
  ho61508:resultsIn nyhkb:Situation_HydrogenJet_CompressorRoom .

nyhkb:Event_Rupture_H2Cylinder a h2hoa:Rupture ;
  rdfs:label "Rupture – hydrogen cylinder"@en ;
  rdfs:comment "Catastrophic failure under external fire / overpressure (Appendix E, section 5.3.2.2)." ;
  dcterms:source "Appendix E, section 5.3.2.2"@en ;
  ho61508:resultsIn nyhkb:Situation_HydrogenJet_H2CylinderRoom ;
  ho61508:triggers nyhkb:Hazard_Pressure_H2Cylinder .

nyhkb:Event_HotSurfaceIgnition_TechnicalRoom a h2hoa:HotSurfaceIgnition ;
