  ho61508:triggers
    nyhkb:Hazard_Deflagration_PipeCulvert ,
    nyhkb:Hazard_JetFire_PipelineRoute ,
    nyhkb:Hazard_Fireball_PipelineRoute .

nyhkb:Event_FrictionIgnition_CompressorRoom a h2hoa:FrictionIgnition ;
  rdfs:label "Ignition – friction/compressor"@en ;
  dcterms:source "Appendix E, section 5.3.2.3"@en ;
  ho61508:triggers
    nyhkb:Hazard_JetFire_CompressorRoom ,
    nyhkb:Hazard_Deflagration_CompressorRoom ,
    nyhkb:Hazard_Fireball_CompressorRoom .

nyhkb:Event_HotSurfaceIgnition_CompressorRoom a h2hoa:HotSurfaceIgnition ;
  rdfs:label "Ignition – hot surfaces (compressor room)"@en ;
  dcterms:source "Appendix E, section 5.3.2.3"@en ;
  ho61508:triggers
    nyhkb:Hazard_JetFire_CompressorRoom ,
    nyhkb:Hazard_Deflagration_CompressorRoom ,
