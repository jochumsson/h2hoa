@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix h2ho: <https://w3id.org/jochumsson/h2ho#> .
@prefix h2hoa: <https://w3id.org/jochumsson/h2hoa#> .
@prefix ho61508: <https://w3id.org/jochumsson/ho61508#> .
@prefix nyhkb: <https://w3id.org/jochumsson/nyhkb#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# KB: Nykvarn hazard analysis knowledge base (NYHKB)
#
# Instantiation of H2HOA from the H2solo hydrogen facility risk analysis
# (Ytterberga 2:5, Vasteras), following the ontological questions in the
# paper (hazards, domain entities, situations, events, causal relations,
# harmful events and harm).
#
# Primary source (Swedish document; English metadata in this file):
#   nykvarn analys/Appendix E - Risk assessment and explosion protection
#   documentation LBE (2023-03-10, Safety Partner).
# Supporting: Appendix D (operations), Appendix C (drawings).
#
# Naming: {Kind}_{EnglishDescriptor}; all rdfs:label and dcterms:source in English.
# Empirical scenarios: empirical-hazard-scenarios.txt (ES-* IDs on hazards).
# Scope (Appendix E section 4): technical room, piping, external building.
#################################################################

<https://w3id.org/jochumsson/nyhkb>
  a owl:Ontology ;
  dcterms:title "Nykvarn Hazard Analysis Knowledge Base (NYHKB)"@en ;
  rdfs:comment "Knowledge base for Nykvarn (H2solo) hazard scenarios, grounded in the 2023 LBE risk analysis (Appendix E) and built on H2HOA."@en ;
  dcterms:creator "Thorvaldur Jochumsson" ;
  dcterms:contributor "Kaj Hanninen" ;
  dcterms:contributor "Mehrdad Saadatmand" ;
  dcterms:contributor "Kristina Lundqvist" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:source "H2solo AB (2023-03-10). Risk assessment and explosion protection documentation LBE, Appendix E, property Ytterberga 2:5."@en ;
  owl:imports <https://w3id.org/jochumsson/h2hoa> ;
  owl:versionInfo "1.2.1" ;
  dcterms:issued "2026-03-22T00:00:00"^^xsd:dateTime ;
  dcterms:modified "2026-06-03T00:00:00"^^xsd:dateTime .

#################################################################
# Physical locations (Appendix E, section 5, handling locations)
#################################################################

nyhkb:Location_TechnicalRoom a h2hoa:PhysicalLocation ;
  rdfs:label "Technical room"@en ;
  rdfs:comment "Equipment room for on-site hydrogen production and consumption (electrolyser, dryer, fuel cell); production at ~35 bar, no storage (Appendix E, section 5.1.1, Table 1)." ;
  dcterms:source "Appendix E, section 5.1.1"@en .

nyhkb:Location_PipelineRoute a h2hoa:PhysicalLocation ;
  rdfs:label "Piping route"@en ;
  rdfs:comment "Hydrogen piping between technical room and external building, above ground, through building, and in pipe culvert (Appendix E, section 5.2.1)." ;
  dcterms:source "Appendix E, section 5.2.1"@en .

nyhkb:Location_CompressorConsumptionRoom a h2hoa:PhysicalLocation ;
  rdfs:label "Compressor and consumption room"@en ;
  rdfs:comment "Room in the external building with compressor, valves, buffer cylinder, and ATEX equipment (Appendix E, section 5.3.1.1)." ;
  dcterms:source "Appendix E, section 5.3.1.1"@en .

nyhkb:Location_H2CylinderRoom a h2hoa:PhysicalLocation ;
  rdfs:label "Hydrogen cylinder room"@en ;
  rdfs:comment "Room housing the 1650 L hydrogen cylinder at 350 bar (Appendix E, section 5.3.1.2, Table 1)." ;
  dcterms:source "Appendix E, section 5.3.1.2"@en .

#################################################################
# Hazardous components (section 5.1 technical room)
#################################################################

nyhkb:Component_TechnicalRoom_Enclosure a h2hoa:EnvironmentalConfinement ;
  rdfs:label "Technical room enclosure"@en ;
  rdfs:comment "Aluminium frame enclosure (PC/Corapan) confining production equipment (Appendix E, section 5.1.1, Figure 4)." ;
  dcterms:source "Appendix E, section 5.1.1"@en ;
  h2hoa:locatedIn nyhkb:Location_TechnicalRoom ;
  h2hoa:carries nyhkb:HazardSource_TechnicalRoom_Confinement .

nyhkb:Component_Electrolyser a h2hoa:Electrolyser ;
  rdfs:label "Electrolyser"@en ;
  rdfs:comment "Electrolyser producing ~1.0785 kg H2/day at ~35 bar (Appendix E, section 5.1.1)." ;
  dcterms:source "Appendix E, section 5.1.1"@en ;
  h2hoa:locatedIn nyhkb:Location_TechnicalRoom ;
  h2hoa:carries nyhkb:HazardSource_Electrolyser .

nyhkb:Component_Dryer a h2hoa:Dryer ;
  rdfs:label "Dryer"@en ;
  rdfs:comment "Dryer in the production chain after electrolysis (Appendix E, section 5.1.1)." ;
  dcterms:source "Appendix E, section 5.1.1"@en ;
  h2hoa:locatedIn nyhkb:Location_TechnicalRoom ;
  h2hoa:carries nyhkb:HazardSource_Dryer .

nyhkb:Component_FuelCell a h2hoa:FuelCell ;
  rdfs:label "Fuel cell"@en ;
  rdfs:comment "Fuel cell consuming hydrogen from storage via regulator (~3–6 bar) for on-site electricity (Appendix E, section 5.1.1, section 5.3)." ;
  dcterms:source "Appendix E, section 5.1.1"@en ;
  h2hoa:locatedIn nyhkb:Location_TechnicalRoom ;
  h2hoa:carries nyhkb:HazardSource_FuelCell .

nyhkb:Component_BatteryStorage a h2hoa:BatteryStorage ;
  rdfs:label "Battery storage (fuel cell)"@en ;
  rdfs:comment "Battery supply for fuel cell; continues consumption after gas shut-off until depleted (Appendix E, section 5.1.1)." ;
  dcterms:source "Appendix E, section 5.1.1"@en ;
  h2hoa:locatedIn nyhkb:Location_TechnicalRoom ;
  h2hoa:carries nyhkb:HazardSource_BatteryStorage .

nyhkb:Component_Inverter a h2hoa:Inverter ;
  rdfs:label "Inverter"@en ;
  rdfs:comment "Inverter associated with the solar/hydrogen power system (Appendix D system description)." ;
  dcterms:source "Appendix D, section 2"@en ;
  h2hoa:locatedIn nyhkb:Location_TechnicalRoom ;
  h2hoa:carries nyhkb:HazardSource_Inverter .

#################################################################
# Hazardous components (section 5.2 piping route)
#################################################################

nyhkb:Component_H2Piping a h2hoa:Piping ;
  rdfs:label "Hydrogen piping"@en ;
  rdfs:comment "Stainless 316L piping at ~35 bar, ~350 bar and ~3–6 bar between technical room and external building (Appendix E, section 5.2.1)." ;
  dcterms:source "Appendix E, section 5.2.1"@en ;
  h2hoa:locatedIn nyhkb:Location_PipelineRoute ;
  h2hoa:carries nyhkb:HazardSource_H2Piping .

nyhkb:Component_PipeCulvert a h2hoa:EnvironmentalConfinement ;
  rdfs:label "Pipe culvert"@en ;
  rdfs:comment "Underground culvert for piping; confined volume with accumulation and pressure-build-up risk (Appendix E, section 5.2.2.1)." ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  h2hoa:locatedIn nyhkb:Location_PipelineRoute ;
  h2hoa:carries nyhkb:HazardSource_PipeCulvert .

#################################################################
# Hazardous components (section 5.3 external building)
#################################################################

nyhkb:Component_CompressorRoom_Enclosure a h2hoa:EnvironmentalConfinement ;
  rdfs:label "Compressor room enclosure"@en ;
  rdfs:comment "Enclosure in external building where explosive atmosphere is likely during normal operation (Appendix E, section 5.3.2.1)." ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  h2hoa:locatedIn nyhkb:Location_CompressorConsumptionRoom ;
  h2hoa:carries nyhkb:HazardSource_CompressorRoom_Confinement .

nyhkb:Component_H2Compressor a h2hoa:ProcessEquipment ;
  rdfs:label "Hydrogen compressor"@en ;
  rdfs:comment "Compressor raising pressure from ~35 bar to ~350 bar (Appendix E, section 5.3.1.1)." ;
  dcterms:source "Appendix E, section 5.3.1.1"@en ;
  h2hoa:locatedIn nyhkb:Location_CompressorConsumptionRoom ;
  h2hoa:carries nyhkb:HazardSource_Compressor .

nyhkb:Component_BufferCylinder a h2hoa:StorageVessel ;
  rdfs:label "Buffer cylinder (portable gas bottle)"@en ;
  rdfs:comment "Small buffer hydrogen cylinder; emptied via needle valve HA-102 to vent line (Appendix E, section 5.3.1.1, section 5.1)." ;
  dcterms:source "Appendix E, section 5.3.1.1"@en ;
  h2hoa:locatedIn nyhkb:Location_CompressorConsumptionRoom ;
  h2hoa:carries nyhkb:HazardSource_BufferCylinder .

nyhkb:Component_H2Cylinder_1650L a h2hoa:HighPressureH2Storage ;
  rdfs:label "Hydrogen cylinder 1650 L / 350 bar"@en ;
  rdfs:comment "Type IV COPV 1650 L at 350 bar in dedicated storage room (Appendix E, section 5.3.1.2, Appendix F)." ;
  dcterms:source "Appendix E, section 5.3.1.2; Appendix F"@en ;
  h2hoa:locatedIn nyhkb:Location_H2CylinderRoom ;
  h2hoa:carries nyhkb:HazardSource_H2Cylinder .

#################################################################
# Exposed entities
#################################################################

nyhkb:ExposedEntity_Personnel a h2hoa:Person ;
  rdfs:label "Personnel and visitors"@en ;
  rdfs:comment "Operators, visitors, maintenance staff near the installation (Appendix E, section 3, Table 4 example)." ;
  dcterms:source "Appendix E, section 3"@en ;
  h2hoa:affectedBy nyhkb:ExposedRole_Person .

nyhkb:ExposedEntity_Property a h2hoa:Property ;
  rdfs:label "Buildings and equipment"@en ;
  rdfs:comment "Buildings, H2solo equipment and infrastructure subject to damage (Appendix E, section 5.2.2.1 consequences)." ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  h2hoa:affectedBy nyhkb:ExposedRole_Property .

nyhkb:ExposedEntity_Environment a h2hoa:Environment ;
  rdfs:label "Surrounding environment"@en ;
  rdfs:comment "Air, soil, and surrounding environment (Appendix E, section 5.3.2.2)." ;
  dcterms:source "Appendix E, section 5.3.2.2"@en ;
  h2hoa:affectedBy nyhkb:ExposedRole_Environment .

#################################################################
# HazardSource roles
#################################################################

nyhkb:HazardSource_TechnicalRoom_Confinement a h2ho:EnvironmentalConfinementHazardSource ;
  rdfs:label "Confinement - technical room"@en ;
  dcterms:source "Appendix E, section 5.1.2.1"@en .

nyhkb:HazardSource_Electrolyser a h2ho:ProcessEquipmentHazardSource ;
  rdfs:label "HazardSource - electrolyser"@en ;
  dcterms:source "Appendix E, section 5.1.2.1"@en .

nyhkb:HazardSource_Dryer a h2ho:ProcessEquipmentHazardSource ;
  rdfs:label "HazardSource - dryer"@en ;
  dcterms:source "Appendix E, section 5.1.2.1"@en .

nyhkb:HazardSource_FuelCell a h2ho:ProcessEquipmentHazardSource ;
  rdfs:label "HazardSource - fuel cell"@en ;
  dcterms:source "Appendix E, section 5.1.2.1"@en .

nyhkb:HazardSource_BatteryStorage a h2ho:ProcessEquipmentHazardSource ;
  rdfs:label "HazardSource - battery storage"@en ;
  dcterms:source "Appendix E, section 5.1.1"@en .

nyhkb:HazardSource_Inverter a h2ho:ProcessEquipmentHazardSource ;
  rdfs:label "HazardSource - inverter"@en ;
  dcterms:source "Appendix D, section 2"@en .

nyhkb:HazardSource_H2Piping a h2ho:PipingHazardSource ;
  rdfs:label "HazardSource - hydrogen piping"@en ;
  dcterms:source "Appendix E, section 5.2.2.1"@en .

nyhkb:HazardSource_PipeCulvert a h2ho:EnvironmentalConfinementHazardSource ;
  rdfs:label "HazardSource - pipe culvert"@en ;
  dcterms:source "Appendix E, section 5.2.2.1"@en .

nyhkb:HazardSource_CompressorRoom_Confinement a h2ho:EnvironmentalConfinementHazardSource ;
  rdfs:label "HazardSource - compressor room"@en ;
  dcterms:source "Appendix E, section 5.3.2.1"@en .

nyhkb:HazardSource_Compressor a h2ho:ProcessEquipmentHazardSource ;
  rdfs:label "HazardSource - compressor"@en ;
  dcterms:source "Appendix E, section 5.3.2.1"@en .

nyhkb:HazardSource_BufferCylinder a h2ho:StorageVesselHazardSource ;
  rdfs:label "HazardSource - buffer cylinder"@en ;
  dcterms:source "Appendix E, section 5.3.2.1"@en .

nyhkb:HazardSource_H2Cylinder a h2ho:StorageVesselHazardSource ;
  rdfs:label "HazardSource - hydrogen cylinder"@en ;
  dcterms:source "Appendix E, section 5.3.2.1–5.3.2.2"@en .

#################################################################
# Exposed roles
#################################################################

nyhkb:ExposedRole_Person a h2ho:ExposedPerson .
nyhkb:ExposedRole_Property a h2ho:ExposedProperty .
nyhkb:ExposedRole_Environment a h2ho:ExposedEnvironment .

#################################################################
# Hazards
#################################################################

# Technical room (section 5.1.2 uncontrolled release to explosive atmosphere)
nyhkb:Hazard_JetFire_TechnicalRoom a h2hoa:JetFireHazard ;
  rdfs:label "Jet fire – technical room"@en ;
  rdfs:comment "Empirical scenario ID: ES-TR-01. See empirical-hazard-scenarios.txt. Jet fire from pressurised release and ignition at production equipment (interpretation of Appendix E, section 5.1.2)." ;
  dcterms:source "Appendix E, section 5.1.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_Electrolyser ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_JetFire_TechnicalRoom .

nyhkb:Hazard_Deflagration_TechnicalRoom a h2hoa:DeflagrationHazard ;
  rdfs:label "Deflagration – technical room"@en ;
  rdfs:comment "Empirical scenario ID: ES-TR-01. See empirical-hazard-scenarios.txt. Deflagration from flammable hydrogen–air mixture in enclosed equipment room (Appendix E, section 5.1.2.1; paper Table 3–4)." ;
  dcterms:source "Appendix E, section 5.1.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_TechnicalRoom_Confinement ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_Deflagration_TechnicalRoom .

nyhkb:Hazard_Detonation_TechnicalRoom a h2hoa:DetonationHazard ;
  rdfs:label "Detonation – technical room (extreme)"@en ;
  rdfs:comment "Empirical scenario ID: ES-TR-02. See empirical-hazard-scenarios.txt. Low-probability detonation under severe confinement (Appendix E, section 5.1.4)." ;
  dcterms:source "Appendix E, section 5.1.4"@en ;
  ho61508:inheresIn nyhkb:HazardSource_TechnicalRoom_Confinement .

nyhkb:Hazard_Fireball_TechnicalRoom a h2hoa:FireballHazard ;
  rdfs:label "Fireball – technical room"@en ;
  rdfs:comment "Empirical scenario ID: ES-TR-01 (Table 4 extension). See empirical-hazard-scenarios.txt. Delayed ignition of dispersed hydrogen cloud in equipment room (paper Table 4)." ;
  dcterms:source "Appendix E, section 5.1.2.1; paper Table 4"@en ;
  ho61508:inheresIn nyhkb:HazardSource_TechnicalRoom_Confinement ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_Fireball_TechnicalRoom .

# Piping route (section 5.2)
nyhkb:Hazard_JetFire_PipelineRoute a h2hoa:JetFireHazard ;
  rdfs:label "Jet fire – piping route"@en ;
  rdfs:comment "Empirical scenario ID: ES-PL-01. See empirical-hazard-scenarios.txt." ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_H2Piping ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_JetFire_PipelineRoute .

nyhkb:Hazard_Deflagration_PipeCulvert a h2hoa:DeflagrationHazard ;
  rdfs:label "Deflagration – pipe culvert"@en ;
  rdfs:comment "Empirical scenario ID: ES-PL-02. See empirical-hazard-scenarios.txt. Accumulation and ignition in culvert; pressure-build-up risk (Appendix E, section 5.2.2.1)." ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_PipeCulvert ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_Deflagration_PipeCulvert .

nyhkb:Hazard_Fireball_PipelineRoute a h2hoa:FireballHazard ;
  rdfs:label "Fireball – piping route"@en ;
  rdfs:comment "Empirical scenario ID: ES-PL-03. See empirical-hazard-scenarios.txt. Delayed ignition of dispersed cloud along piping corridor (Appendix E, section 5.2.2)." ;
  dcterms:source "Appendix E, section 5.2.2"@en ;
  ho61508:inheresIn nyhkb:HazardSource_H2Piping ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_Fireball_PipelineRoute .

# External building (section 5.3)
nyhkb:Hazard_JetFire_CompressorRoom a h2hoa:JetFireHazard ;
  rdfs:label "Jet fire – compressor room"@en ;
  rdfs:comment "Empirical scenario ID: ES-EB-CR-01. See empirical-hazard-scenarios.txt." ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_Compressor ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_JetFire_CompressorRoom .

nyhkb:Hazard_Fireball_CompressorRoom a h2hoa:FireballHazard ;
  rdfs:label "Fireball – compressor room"@en ;
  rdfs:comment "Empirical scenario ID: ES-EB-CR-01. See empirical-hazard-scenarios.txt." ;
  dcterms:source "Appendix E, section 5.3.2.3"@en ;
  ho61508:inheresIn nyhkb:HazardSource_CompressorRoom_Confinement ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_Fireball_CompressorRoom .

nyhkb:Hazard_Deflagration_CompressorRoom a h2hoa:DeflagrationHazard ;
  rdfs:label "Deflagration – compressor room"@en ;
  rdfs:comment "Empirical scenario ID: ES-EB-CR-01. See empirical-hazard-scenarios.txt." ;
  dcterms:source "Appendix E, section 5.3.2.3"@en ;
  ho61508:inheresIn nyhkb:HazardSource_CompressorRoom_Confinement ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_Deflagration_CompressorRoom .

nyhkb:Hazard_JetFire_BufferCylinder a h2hoa:JetFireHazard ;
  rdfs:label "Jet fire - buffer cylinder"@en ;
  rdfs:comment "Empirical scenario ID: ES-EB-CR-02. See empirical-hazard-scenarios.txt." ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_BufferCylinder ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_JetFire_BufferCylinder .

nyhkb:Hazard_JetFire_H2Cylinder a h2hoa:JetFireHazard ;
  rdfs:label "Jet fire – hydrogen cylinder"@en ;
  rdfs:comment "Empirical scenario ID: ES-EB-ST-01. See empirical-hazard-scenarios.txt." ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_H2Cylinder ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_JetFire_H2CylinderRoom .

nyhkb:Hazard_Pressure_Compressor a h2ho:PressureHazard ;
  rdfs:comment "Empirical scenario ID: ES-EB-CR-03. See empirical-hazard-scenarios.txt." ;
  rdfs:label "Pressure hazard - compressor"@en ;
  dcterms:source "Appendix E, section 5.3.1.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_Compressor ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_PressureExposure_CompressorRoom .

nyhkb:Hazard_Pressure_H2Cylinder a h2ho:PressureHazard ;
  rdfs:label "Pressure hazard – hydrogen cylinder"@en ;
  rdfs:comment "Empirical scenario ID: ES-EB-ST-01. See empirical-hazard-scenarios.txt." ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:inheresIn nyhkb:HazardSource_H2Cylinder ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_PressureExposure_H2CylinderRoom .

nyhkb:Hazard_Thermal_H2Cylinder a h2ho:ThermalHazard ;
  rdfs:label "Thermal hazard – hydrogen cylinder (external fire)"@en ;
  rdfs:comment "Empirical scenario ID: ES-EB-ST-02. See empirical-hazard-scenarios.txt. Cylinder heating from external fire in adjacent room (Appendix E, section 5.3.2.2)." ;
  dcterms:source "Appendix E, section 5.3.2.2"@en ;
  ho61508:inheresIn nyhkb:HazardSource_H2Cylinder ;
  ho61508:manifestsIn nyhkb:HarmfulEvent_ThermalExposure_ExternalBuilding .

#################################################################
# Hazardous situations
#################################################################

nyhkb:Situation_HydrogenJet_TechnicalRoom a h2hoa:HydrogenJet ;
  rdfs:label "Hydrogen jet – technical room"@en ;
  dcterms:source "Appendix E, section 5.1.2.1"@en ;
  ho61508:involves nyhkb:Hazard_JetFire_TechnicalRoom ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_HotSurfaceIgnition_TechnicalRoom , nyhkb:Event_StaticSparkIgnition_TechnicalRoom .

nyhkb:Situation_ExplosiveAtmosphere_TechnicalRoom a h2hoa:DeflagrationCondition ;
  rdfs:label "Explosive atmosphere – technical room"@en ;
  rdfs:comment "Explosive atmosphere after uncontrolled release (paper Table 3; Appendix E, section 5.1.2.1)." ;
  dcterms:source "Appendix E, section 5.1.2.1; paper Table 3"@en ;
  ho61508:involves nyhkb:Hazard_Deflagration_TechnicalRoom ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_HotSurfaceIgnition_TechnicalRoom , nyhkb:Event_StaticSparkIgnition_TechnicalRoom .

nyhkb:Situation_DetonationCondition_TechnicalRoom a h2hoa:DetonationCondition ;
  rdfs:label "Detonation conditions – technical room"@en ;
  dcterms:source "Appendix E, section 5.1.4"@en ;
  ho61508:involves nyhkb:Hazard_Detonation_TechnicalRoom ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_HighEnergyIgnition_TechnicalRoom .

nyhkb:Situation_EquipmentDamage_TechnicalRoom a h2hoa:DamagedEquipmentDegradation ;
  rdfs:label "Equipment damage – technical room"@en ;
  dcterms:source "Appendix E, section 5.1.2 consequences"@en ;
  ho61508:involves nyhkb:Hazard_JetFire_TechnicalRoom ;
  ho61508:exposes nyhkb:ExposedRole_Property , nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Environment ;
  ho61508:enables nyhkb:Event_LowPressureRelease_TechnicalRoom , nyhkb:Event_StaticSparkIgnition_TechnicalRoom .

nyhkb:Situation_HydrogenJet_PipelineRoute a h2hoa:HydrogenJet ;
  rdfs:label "Hydrogen jet – piping route"@en ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  ho61508:involves nyhkb:Hazard_JetFire_PipelineRoute ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_StaticSparkIgnition_PipelineRoute .

nyhkb:Situation_FlammableCloud_PipelineRoute a h2hoa:FlammableVaporCloud ;
  rdfs:label "Flammable vapor cloud – piping route"@en ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  ho61508:involves nyhkb:Hazard_Fireball_PipelineRoute ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_StaticSparkIgnition_PipelineRoute .

nyhkb:Situation_ExplosiveAtmosphere_PipeCulvert a h2hoa:DeflagrationCondition ;
  rdfs:label "Explosive atmosphere – pipe culvert"@en ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  ho61508:involves nyhkb:Hazard_Deflagration_PipeCulvert ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_StaticSparkIgnition_PipelineRoute .

nyhkb:Situation_HydrogenJet_CompressorRoom a h2hoa:HydrogenJet ;
  rdfs:label "Hydrogen jet – compressor room"@en ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:involves nyhkb:Hazard_JetFire_CompressorRoom ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_FrictionIgnition_CompressorRoom .

nyhkb:Situation_ExplosiveAtmosphere_CompressorRoom a h2hoa:DeflagrationCondition ;
  rdfs:label "Explosive atmosphere – compressor room"@en ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:involves nyhkb:Hazard_Deflagration_CompressorRoom ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables
    nyhkb:Event_FrictionIgnition_CompressorRoom ,
    nyhkb:Event_HotSurfaceIgnition_CompressorRoom ,
    nyhkb:Event_StaticSparkIgnition_CompressorRoom .

nyhkb:Situation_FlammableCloud_CompressorRoom a h2hoa:FlammableVaporCloud ;
  rdfs:label "Flammable vapor cloud – compressor room"@en ;
  dcterms:source "Appendix E, section 5.3.2.1"@en ;
  ho61508:involves nyhkb:Hazard_Fireball_CompressorRoom ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables
    nyhkb:Event_EscalationIgnition_CompressorRoom ,
    nyhkb:Event_FrictionIgnition_CompressorRoom ,
    nyhkb:Event_HotSurfaceIgnition_CompressorRoom ,
    nyhkb:Event_StaticSparkIgnition_CompressorRoom .

nyhkb:Situation_HydrogenJet_H2CylinderRoom a h2hoa:HydrogenJet ;
  rdfs:label "Hydrogen jet – hydrogen cylinder room"@en ;
  dcterms:source "Appendix E, section 5.3.2.1; section 5.3.2.2"@en ;
  ho61508:involves nyhkb:Hazard_JetFire_H2Cylinder ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property , nyhkb:ExposedRole_Environment ;
  ho61508:enables nyhkb:Event_StaticSparkIgnition_CompressorRoom .

nyhkb:Situation_FlammableCloud_TechnicalRoom a h2hoa:FlammableVaporCloud ;
  rdfs:label "Flammable vapor cloud – technical room"@en ;
  dcterms:source "Appendix E, section 5.1.2.1; paper Table 4"@en ;
  ho61508:involves nyhkb:Hazard_Fireball_TechnicalRoom ;
  ho61508:exposes nyhkb:ExposedRole_Person , nyhkb:ExposedRole_Property ;
  ho61508:enables nyhkb:Event_HotSurfaceIgnition_TechnicalRoom , nyhkb:Event_StaticSparkIgnition_TechnicalRoom .

nyhkb:Situation_EquipmentDamage_ExternalFire a h2hoa:DamagedEquipmentDegradation ;
  rdfs:label "Equipment damage – external fire impact"@en ;
  rdfs:comment "Equipment degradation from external fire impacting storage/compressor rooms (Appendix E, section 5.3.2.2)." ;
  dcterms:source "Appendix E, section 5.3.2.2"@en ;
  ho61508:exposes nyhkb:ExposedRole_Property , nyhkb:ExposedRole_Environment , nyhkb:ExposedRole_Person ;
  ho61508:enables nyhkb:Event_Rupture_BufferCylinder , nyhkb:Event_Rupture_H2Cylinder .

#################################################################
# Hazardous events
#################################################################

nyhkb:Event_LowPressureRelease_TechnicalRoom a h2hoa:LowPressureRelease ;
  rdfs:label "Uncontrolled low-pressure release – technical room"@en ;
  rdfs:comment "Cause: incorrect installation or external impact on production equipment (Appendix E, section 5.1.2.1 cause)." ;
  dcterms:source "Appendix E, section 5.1.2.1 cause"@en ;
  ho61508:resultsIn
    nyhkb:Situation_ExplosiveAtmosphere_TechnicalRoom ,
    nyhkb:Situation_FlammableCloud_TechnicalRoom .

nyhkb:Event_LowPressureRelease_PipelineRoute a h2hoa:LowPressureRelease ;
  rdfs:label "Uncontrolled low-pressure release – piping route"@en ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  ho61508:resultsIn
    nyhkb:Situation_FlammableCloud_PipelineRoute ,
    nyhkb:Situation_ExplosiveAtmosphere_PipeCulvert .

nyhkb:Event_HighPressureRelease_PipelineRoute a h2hoa:HighPressureRelease ;
  rdfs:label "Uncontrolled high-pressure release – piping route"@en ;
  dcterms:source "Appendix E, section 5.2.2.1"@en ;
  ho61508:resultsIn
    nyhkb:Situation_HydrogenJet_PipelineRoute ,
    nyhkb:Situation_FlammableCloud_PipelineRoute ,
    nyhkb:Situation_ExplosiveAtmosphere_PipeCulvert .

nyhkb:Event_HighPressureRelease_CompressorRoom a h2hoa:HighPressureRelease ;
